ENVIRONMENT=local
VAULT_YAML_PATH=./vault-secrets.local.yaml

AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=default
AWS_LOCAL_ENDPOINT_URL=http://localhost:4566

OPENSEARCH_HOST=https://search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_IAM_ACCESS_ROLE=arn:aws:iam::123456789012:role/opensearch-access

AWS_RECEIVE_SQS_ENDPOINT=http://localhost:4566/000000000000/sentence-similarity-local.fifo
AWS_SQS_SENT_EVENT_QUEUE_ENDPOINT=http://localhost:4566/000000000000/case-similarity-local.fifo
