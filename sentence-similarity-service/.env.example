VAULT_YAML_PATH=/path/to/mounted/vault-secrets.yaml
DATABASE_POOL_SIZE=30
DATABASE_MAX_OVERFLOW=10

AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=

OPENSEARCH_HOST=search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_IAM_ACCESS_ROLE=arn:aws:iam::123456789012:role/opensearch-access
OPENSEARCH_OCCURRENCE_ALIAS=sentence_occurrences
OPENSEARCH_ASYLEE_CATALOG_ALIAS=sentence_semantic_catalog_asylee
OPENSEARCH_REFUGEE_CATALOG_ALIAS=sentence_semantic_catalog_refugee
OPENSEARCH_TRACER_ALIAS=tracer_form_language_catalog

SENTENCE_SIMILARITY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/sentence-similarity.fifo
API_TRANSFORM_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/api-transform.fifo
AWS_SQS_WAIT_TIME_FOR_NEXT_MESSAGE_BATCH=10
AWS_SQS_VISIBILITY_TIMEOUT=7200

MATCH_THRESHOLD=90
TRACER_THRESHOLD=90
IVF_NPROBES=16
