DATABASE_URL=postgresql+psycopg://user:password@database-host:5432/database
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=5

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
IAM_ACCESS_ROLE=

OPENSEARCH_HOST=search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_PORT=443
OPENSEARCH_SERVICE=es
OPENSEARCH_OCCURRENCE_ALIAS=sentence_occurrences
OPENSEARCH_CATALOG_ALIAS=sentence_semantic_catalog
OPENSEARCH_TRACER_ALIAS=tracer_form_language_catalog

SENTENCE_SIMILARITY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/sentence-similarity.fifo
API_TRANSFORM_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/api-transform.fifo
SIMILARITY_COMPLETE_STATE=API_TRANSFORM
SQS_WAIT_SECONDS=20
SQS_VISIBILITY_SECONDS=7200

SOURCE_PAGE_SIZE=100
WORKER_COUNT=16
MATCH_WRITE_BATCH_SIZE=500
CATALOG_PAGE_SIZE=1000
MATCH_THRESHOLD=90
TRACER_THRESHOLD=90
IVF_NPROBES=16
VECTOR_DIMENSION=512
RETRY_SECONDS=5
