ENVIRONMENT=local

PG_DB_USER=postgres
PG_DB_PASSWORD=postgres
PG_DB_HOST=localhost
PG_DB_PORT=5432
PG_DB_DATABASE=postgres

AWS_DEFAULT_REGION=us-east-1
AWS_LOCAL_ENDPOINT_URL=http://localhost:4566
AWS_RECEIVE_SQS_QUEUE_ENDPOINT=http://localhost:4566/000000000000/api-transform-local.fifo
AWS_DLQ_SQS_QUEUE_ENDPOINT=http://localhost:4566/000000000000/api-transform-dlq-local.fifo
AWS_SQS_SEND_EVENT_QUEUE_ENDPOINT=http://localhost:4566/000000000000/next-local.fifo

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_ENV=local
KAFKA_COMPRESSION=lz4
REDUCE_KAFKA_SIZE=false
VERBOSE_KAFKA_LOGGING=false
