<mxfile host="Electron" agent="Codex">
  <diagram id="vertical-sentence-flow" name="Vertical Architecture">
    <mxGraphModel dx="1548" dy="1065" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontColor=#17233C;" value="&lt;b&gt;Sentence Processing and Matching&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Three OpenSearch indexes · One sentence processed at a time&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="700" x="400" y="20" as="geometry" />
        </mxCell>
        <mxCell id="f4QYdpgNEZf4QgKVUJW1-1" edge="1" parent="1" source="docSection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="similaritySection">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="docSection" parent="1" style="swimlane;html=1;horizontal=1;startSize=50;rounded=1;arcSize=6;fillColor=#F7FBFF;swimlaneFillColor=#D9EAF7;strokeColor=#4A86C5;strokeWidth=2;fontColor=#17365D;fontSize=18;" value="&lt;b&gt;1 · DOC2Vec Service&lt;/b&gt;" vertex="1">
          <mxGeometry height="930" width="620" x="50" y="100" as="geometry" />
        </mxCell>
        <mxCell id="docInput" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A86C5;fontSize=13;" value="&lt;b&gt;Receive document&lt;/b&gt;&lt;br&gt;tsp_id + application_id + full text" vertex="1">
          <mxGeometry height="65" width="380" x="120" y="75" as="geometry" />
        </mxCell>
        <mxCell id="prepare" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A86C5;fontSize=13;" value="&lt;b&gt;Prepare sentences&lt;/b&gt;&lt;br&gt;Split text in order&lt;br&gt;Normalize text and create sentence_key" vertex="1">
          <mxGeometry height="85" width="380" x="120" y="175" as="geometry" />
        </mxCell>
        <mxCell id="sentenceVector" parent="docSection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="&lt;b&gt;PostgreSQL sentences_vector&lt;/b&gt;&lt;br&gt;Save every sentence&lt;br&gt;Receive every global_id" vertex="1">
          <mxGeometry height="100" width="350" x="135" y="300" as="geometry" />
        </mxCell>
        <mxCell id="occurrenceIndex" parent="docSection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="&lt;b&gt;OpenSearch 1 of 3&lt;/b&gt;&lt;br&gt;sentence_occurrences&lt;br&gt;Every global_id and its document location&lt;br&gt;Includes classification flags" vertex="1">
          <mxGeometry height="120" width="390" x="115" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mainCatalog" parent="docSection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="&lt;b&gt;OpenSearch 2 of 3&lt;/b&gt;&lt;br&gt;sentence_semantic_catalog&lt;br&gt;One Titan vector per sentence_key&lt;br&gt;Create only missing vectors" vertex="1">
          <mxGeometry height="120" width="390" x="115" y="610" as="geometry" />
        </mxCell>
        <mxCell id="docComplete" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="&lt;b&gt;DOC2Vec complete&lt;/b&gt;&lt;br&gt;Send tsp_id to Sentence Similarity" vertex="1">
          <mxGeometry height="75" width="350" x="135" y="790" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="docSection" source="docInput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="prepare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="docSection" source="prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="sentenceVector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="docSection" source="sentenceVector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="occurrenceIndex">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="docSection" source="occurrenceIndex" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="mainCatalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="docSection" source="mainCatalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;" target="docComplete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="similaritySection" parent="1" style="swimlane;html=1;horizontal=1;startSize=50;rounded=1;arcSize=6;fillColor=#FCF9FE;swimlaneFillColor=#EADCF2;strokeColor=#8E5EA2;strokeWidth=2;fontColor=#4C2B63;fontSize=18;" value="&lt;b&gt;2 · Sentence Similarity Service&lt;/b&gt;" vertex="1">
          <mxGeometry height="930" width="660" x="790" y="100" as="geometry" />
        </mxCell>
        <mxCell id="similarityInput" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;fontSize=13;" value="&lt;b&gt;Receive tsp_id&lt;/b&gt;&lt;br&gt;Start after DOC2Vec completes" vertex="1">
          <mxGeometry height="65" width="360" x="150" y="70" as="geometry" />
        </mxCell>
        <mxCell id="oneSentence" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;fontSize=13;" value="&lt;b&gt;Take one source sentence&lt;/b&gt;&lt;br&gt;Keep global_id, sentence_key, and group&lt;br&gt;Read its saved vector" vertex="1">
          <mxGeometry height="85" width="390" x="135" y="165" as="geometry" />
        </mxCell>
        <mxCell id="nonMatcherCatalog" parent="similaritySection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="&lt;b&gt;OpenSearch 3 of 3&lt;/b&gt;&lt;br&gt;tracer_form_language_catalog&lt;br&gt;Lucene HNSW · about 4,000 references&lt;br&gt;Filter group + isNonMatcher" vertex="1">
          <mxGeometry height="120" width="420" x="120" y="285" as="geometry" />
        </mxCell>
        <mxCell id="nonMatcherDecision" parent="similaritySection" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="&lt;b&gt;Non-matcher&lt;br&gt;found?&lt;/b&gt;" vertex="1">
          <mxGeometry height="90" width="150" x="255" y="445" as="geometry" />
        </mxCell>
        <mxCell id="updateSentenceVector" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="&lt;b&gt;Save classification&lt;/b&gt;&lt;br&gt;Update sentences_vector by global_id&lt;br&gt;Update occurrence by the same ID&lt;br&gt;Save no relationships" vertex="1">
          <mxGeometry height="100" width="205" x="440" y="440" as="geometry" />
        </mxCell>
        <mxCell id="findMatches" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;fontSize=13;" value="&lt;b&gt;Find allowed matches&lt;/b&gt;&lt;br&gt;Exact: same sentence_key&lt;br&gt;Similar: search main sentence catalog&lt;br&gt;Remove same application and non-matcher targets" vertex="1">
          <mxGeometry height="110" width="430" x="115" y="575" as="geometry" />
        </mxCell>
        <mxCell id="dualWrite" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;strokeWidth=2;fontSize=13;" value="&lt;b&gt;Write both directions and commit&lt;/b&gt;&lt;br&gt;Then take the next source sentence" vertex="1">
          <mxGeometry height="75" width="380" x="140" y="720" as="geometry" />
        </mxCell>
        <mxCell id="oldMatches" parent="similaritySection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" value="&lt;b&gt;Existing matches&lt;/b&gt;&lt;br&gt;Global-ID JSONB list&lt;br&gt;Production reads this now" vertex="1">
          <mxGeometry height="95" width="270" x="35" y="825" as="geometry" />
        </mxCell>
        <mxCell id="newMatches" parent="similaritySection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" value="&lt;b&gt;New sentence_key_matches&lt;/b&gt;&lt;br&gt;Key + group + distance&lt;br&gt;Use after backfill and validation" vertex="1">
          <mxGeometry height="95" width="270" x="355" y="825" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="similaritySection" source="similarityInput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E5EA2;strokeWidth=2;" target="oneSentence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="similaritySection" source="oneSentence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E5EA2;strokeWidth=2;" target="nonMatcherCatalog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="similaritySection" source="nonMatcherCatalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;" target="nonMatcherDecision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" edge="1" parent="similaritySection" source="nonMatcherDecision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82B366;strokeWidth=2;fontSize=12;" target="findMatches" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="similaritySection" source="nonMatcherDecision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="updateSentenceVector" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10b" edge="1" parent="similaritySection" source="updateSentenceVector" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#B85450;strokeWidth=2;fontSize=11;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="oneSentence" value="Commit · next sentence">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="490" />
              <mxPoint x="650" y="205" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" edge="1" parent="similaritySection" source="findMatches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E5EA2;strokeWidth=2;" target="dualWrite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" edge="1" parent="similaritySection" source="dualWrite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;" target="oldMatches">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" edge="1" parent="similaritySection" source="dualWrite" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;strokeWidth=2;" target="newMatches">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
