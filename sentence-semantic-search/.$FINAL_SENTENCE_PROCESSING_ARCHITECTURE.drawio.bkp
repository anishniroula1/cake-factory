        <mxCell id="oneSentence" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;fontSize=13;" value="&lt;b&gt;Take one eligible sentence&lt;/b&gt;&lt;br&gt;Skip tracer and form language&lt;br&gt;Keep its global_id and sentence_key" vertex="1">
          <mxGeometry height="90" width="380" x="105" y="185" as="geometry" />
