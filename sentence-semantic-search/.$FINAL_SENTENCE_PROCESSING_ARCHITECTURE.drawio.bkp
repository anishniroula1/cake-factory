        <mxCell id="findMatches" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8E5EA2;fontSize=13;" value="&lt;b&gt;Find this sentence&#39;s matches&lt;/b&gt;&lt;br&gt;Exact: same sentence_key&lt;br&gt;Similar: one OpenSearch vector search&lt;br&gt;Exclude the same application" vertex="1">
          <mxGeometry height="110" width="380" x="105" y="315" as="geometry" />
        </mxCell>
