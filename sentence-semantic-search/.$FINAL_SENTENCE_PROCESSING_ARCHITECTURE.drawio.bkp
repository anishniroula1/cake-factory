        <mxCell id="newMatches" parent="similaritySection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" value="&lt;b&gt;New sentence_key_matches&lt;/b&gt;&lt;br&gt;Key + group + distance&lt;br&gt;Write only until history finishes" vertex="1">
          <mxGeometry height="115" width="255" x="310" y="600" as="geometry" />
        </mxCell>
        <mxCell id="transition" parent="similaritySection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="&lt;b&gt;Do not switch reads yet&lt;/b&gt;&lt;br&gt;Use the new table only after every historical document finishes and validation passes." vertex="1">
          <mxGeometry height="60" width="400" x="95" y="755" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="similaritySection" source="similarityInput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#8E5EA2;strokeWidth=2;" target="oneSentence">
