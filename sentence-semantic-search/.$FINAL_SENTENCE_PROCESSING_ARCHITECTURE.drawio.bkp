          <mxGeometry height="85" width="330" x="130" y="465" as="geometry" />
        </mxCell>
        <mxCell id="oldMatches" parent="similaritySection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" value="&lt;b&gt;Existing tsp.matches&lt;/b&gt;&lt;br&gt;Global-ID JSONB list&lt;br&gt;API Transform reads this now" vertex="1">
