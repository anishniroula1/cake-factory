<mxfile host="Electron" agent="Codex">
  <diagram id="vertical-sentence-flow" name="Vertical Architecture">
    <mxGraphModel dx="1341" dy="923" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
