          <mxGeometry height="65" width="330" x="130" y="80" as="geometry" />
        </mxCell>
        <mxCell id="prepare" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A86C5;fontSize=13;" value="&lt;b&gt;Prepare sentences&lt;/b&gt;&lt;br&gt;Split text in order&lt;br&gt;Mark tracer and form language&lt;br&gt;Create sentence_key" vertex="1">
          <mxGeometry height="105" width="380" x="105" y="190" as="geometry" />
        </mxCell>
        <mxCell id="sentenceVector" parent="docSection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="&lt;b&gt;Insert sentences_vector&lt;/b&gt;&lt;br&gt;Save every sentence&lt;br&gt;Receive every global_id" vertex="1">
          <mxGeometry height="105" width="330" x="130" y="345" as="geometry" />
        </mxCell>
        <mxCell id="openSearch" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="&lt;b&gt;Index OpenSearch&lt;/b&gt;&lt;br&gt;Occurrence index: every global_id&lt;br&gt;Catalog: one vector per sentence_key&lt;br&gt;Retry Lasso/Titan failures" vertex="1">
          <mxGeometry height="120" width="380" x="105" y="500" as="geometry" />
        </mxCell>
        <mxCell id="docComplete" parent="docSection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="&lt;b&gt;DOC2Vec complete&lt;/b&gt;&lt;br&gt;Send tsp_id to Sentence Similarity" vertex="1">
          <mxGeometry height="75" width="330" x="130" y="675" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="docSection" source="docInput" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="prepare">
