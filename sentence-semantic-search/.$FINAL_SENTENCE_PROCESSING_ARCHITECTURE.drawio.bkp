        <mxCell id="e2" edge="1" parent="docSection" source="prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4A86C5;strokeWidth=2;" target="sentenceVector">
