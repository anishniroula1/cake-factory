VAULT_YAML_PATH=/path/to/mounted/vault-secrets.yaml
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT_URL=

OPENSEARCH_HOST=search-your-domain.us-east-1.es.amazonaws.com
OPENSEARCH_IAM_ACCESS_ROLE=
OPENSEARCH_OCCURRENCE_ALIAS=sentence_occurrences
OPENSEARCH_CATALOG_ALIAS=sentence_semantic_catalog

SENTENCE_SIMILARITY_BACKFILL_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/account/sentence-similarity-backfill.fifo
AWS_SQS_WAIT_TIME_FOR_NEXT_MESSAGE_BATCH=10
AWS_SQS_VISIBILITY_TIMEOUT=7200

VECTOR_DIMENSION=512
